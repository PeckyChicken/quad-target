[sub_resource type="GDScript" id="GDScript_dg77c"]
script/source = "extends RichTextLabel
@onready var MAIN_SCENE: PackedScene = load(\"res://main.tscn\")
@onready var MOBILE_SCENE: PackedScene = load(\"res://mobile.tscn\")

@onready var root = $\"../..\"

@onready var icons: Dictionary[Root.Difficulty,String] = {
	Root.Difficulty.easy : \"res://Icons/easy_mode.svg\",
	Root.Difficulty.hard : \"res://Icons/hard_mode.svg\",
	Root.Difficulty.harder : \"res://Icons/harder_mode.svg\"
}

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	await get_tree().process_frame
	text = \"[img]%s[/img] %s Mode\" % [icons[root.difficulty],Root.Difficulty.keys()[root.difficulty].capitalize()]

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta: float) -> void:
	pass
"

